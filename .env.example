ANTHROPIC_API_KEY=
CLAUDE_MODEL=
# Thinking: on or off (default on). Read by src/config.py for chat.py, ask.py and main.py.
CLAUDE_THINKING=
# Effort: low, medium, high, xhigh or max (default low). With thinking off, use low, medium or high.
CLAUDE_EFFORT=
# Streaming: on or off (default on). Applies to chat.py and plain ask.py; ask.py --json never streams.
CLAUDE_STREAM=
